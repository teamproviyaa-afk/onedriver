# ---------------------------------------------------------------------------------------------
# Secrets for the `payouts` function (Cashfree). Copy to supabase/.env.payouts (git-ignored),
# fill in the Cashfree keys, then run:  bash supabase/setup-payouts.sh
# Never commit supabase/.env.payouts.
# ---------------------------------------------------------------------------------------------

# sandbox while testing, production when live
CASHFREE_ENV=sandbox

# Cashfree dashboard → Payouts → Developers → API Keys
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# Payouts → Developers → Two-Factor Authentication → Public Key (Supabase has no fixed IP to whitelist).
# Paste the PEM on one line with \n between lines, or just the base64 body.
CASHFREE_PAYOUT_PUBLIC_KEY=

# Secure ID (bank / UPI verification). Leave empty to reuse the payout keys above.
CASHFREE_VERIFICATION_CLIENT_ID=
CASHFREE_VERIFICATION_CLIENT_SECRET=
CASHFREE_VERIFICATION_PUBLIC_KEY=

# Limits per payout, in rupees
PAYOUT_MIN_AMOUNT=100
PAYOUT_MAX_AMOUNT=10000

# Optional: your One Local server endpoint that receives final payout statuses (signed)
PAYOUT_STATUS_CALLBACK_URL=

# ── Generated by setup-payouts.sh (leave empty) ───────────────────────────────────────────────
PAYOUT_PAYLOAD_KEY=
PAYOUTS_API_SECRET=
