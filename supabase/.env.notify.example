# ---------------------------------------------------------------------------------------------
# Secrets for the `notify` messaging function. Copy to supabase/.env.notify (git-ignored),
# fill in the providers you use, then run:  bash supabase/setup-messaging.sh
# Leave the generated values empty — the script fills them in once and keeps them.
# Never commit supabase/.env.notify.
# ---------------------------------------------------------------------------------------------

# ── WhatsApp ── meta | twilio | none
WHATSAPP_PROVIDER=meta
# Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# App → Settings → Basic → App secret (verifies delivery webhooks)
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Language code of your approved templates (en, en_US, hi, …)
WA_TEMPLATE_LANGUAGE=en
# Optional: use other approved template names
# WA_TEMPLATE_LOGIN_OTP=onelocal_login_otp

# ── SMS ── msg91 | twilio | none
SMS_PROVIDER=msg91
# MSG91 (India, DLT): one Flow per template, variables named like the params
MSG91_AUTH_KEY=
MSG91_FLOW_LOGIN_OTP=
MSG91_FLOW_DELIVERY_OTP=
MSG91_FLOW_ORDER_DELIVERED=
MSG91_FLOW_RIDER_APPROVED=
MSG91_FLOW_PAYOUT_SENT=
MSG91_FLOW_SOS_ALERT=

# Twilio (instead of MSG91 and/or Meta)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
# TWILIO_CONTENT_SID_LOGIN_OTP=

# ── Email ── resend | none
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="OneLocal <no-reply@your-domain.in>"

# ── Generated by setup-messaging.sh (leave empty) ─────────────────────────────────────────────
MESSAGE_HASH_PEPPER=
MESSAGE_PAYLOAD_KEY=
NOTIFY_API_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
SEND_SMS_HOOK_SECRET=
NOTIFY_PUBLIC_URL=
