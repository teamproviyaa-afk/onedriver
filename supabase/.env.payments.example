# ---------------------------------------------------------------------------------------------
# Secrets for the `payments` function (Cashfree Payment Gateway — rider cash deposits).
# Copy to supabase/.env.payments (git-ignored), fill in the keys, then run:
#   bash supabase/setup-payments.sh
# Never commit supabase/.env.payments.
# ---------------------------------------------------------------------------------------------

# Cashfree dashboard → Payment Gateway → Developers → API Keys: App ID, then Secret Key.
# Production secret keys start with cfsk_ma_prod_, test keys with cfsk_ma_test_ — the function
# uses the environment the key belongs to (production keys move real money).
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=

# Payment methods on the checkout: upi (default, no card fees), or e.g. upi,nb,dc — "all" for every method.
PAYMENT_METHODS=upi
# Limits per deposit, in rupees
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=50000
# How long a payment link stays open (15–1440 minutes)
DEPOSIT_LINK_MINUTES=30
# Where the checkout sends the rider back (the app's deep link)
APP_RETURN_URL=onelocalrider://cash

# Optional: your One Local server endpoint that receives final deposit statuses (signed)
PAYMENT_STATUS_CALLBACK_URL=

# ── Generated by setup-payments.sh (leave empty) ─────────────────────────────────────────────
PAYMENTS_API_SECRET=
