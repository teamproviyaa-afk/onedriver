# ---------------------------------------------------------------------------------------------
# Secrets for the `kyc` function (Cashfree Secure ID — rider KYC). Copy to supabase/.env.kyc
# (git-ignored), fill in the keys, then run:  bash supabase/setup-kyc.sh
# Never commit supabase/.env.kyc.
# ---------------------------------------------------------------------------------------------

# Cashfree dashboard → Secure ID → Developers → API Keys: Client ID and Client Secret.
# Production secrets start with cfsk_ma_prod_, test secrets with cfsk_ma_test_ — the function uses
# the environment the key belongs to (every production check is billed by Cashfree).
CASHFREE_SECURE_ID_CLIENT_ID=
CASHFREE_SECURE_ID_CLIENT_SECRET=
# Secure ID → Developers → Two-Factor Authentication → Public Key (Supabase has no fixed IP to whitelist).
# Paste the PEM on one line with \n between lines, or just the base64 body.
CASHFREE_SECURE_ID_PUBLIC_KEY=

# Cashfree calls per rider, per check, per 24 hours (each call is billed)
KYC_ATTEMPTS_PER_DAY=5
# Selfie ↔ Aadhaar photo face match threshold (0–1)
KYC_FACE_MATCH_THRESHOLD=0.75
# Where DigiLocker sends the rider back (the app's KYC screen)
KYC_APP_RETURN_URL=onelocalrider://onboarding/kyc

# ── Generated by setup-kyc.sh (leave empty) ──────────────────────────────────────────────────
KYC_PAYLOAD_KEY=
KYC_API_SECRET=
