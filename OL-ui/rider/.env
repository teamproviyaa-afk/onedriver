# ------------------------------------------------------------------
# OneLocal Rider — local demo environment
# Source variables (canonical names, do not rename)
# ------------------------------------------------------------------
APP_ENV=local
DATA_MODE=local_demo
SUPABASE_URL=https://ywylhzcxuoeilygzdonx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_jx2WYiDuTQYrfIFd2BdGew_G_xNg1bG
PROVIYAA_API_BASE_URL=
SYNC_ENABLED=false

# ------------------------------------------------------------------
# Expo only inlines EXPO_PUBLIC_* variables into the client bundle.
# These mirror the canonical variables above (dotenv-expand).
# ------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=${APP_ENV}
EXPO_PUBLIC_DATA_MODE=${DATA_MODE}
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
EXPO_PUBLIC_PROVIYAA_API_BASE_URL=${PROVIYAA_API_BASE_URL}
EXPO_PUBLIC_SYNC_ENABLED=${SYNC_ENABLED}

# Optional: Google Maps key for react-native-maps (Android native builds only).
# Leave empty for the development map fallback.
GOOGLE_MAPS_ANDROID_API_KEY=
